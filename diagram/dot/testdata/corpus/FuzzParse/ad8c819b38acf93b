string("// Whether to deploy on a Friday afternoon: a flow chart, laid out in\n// layers from its edges -- no columns or rows, so each step goes below the\n// one before it and a decision's branches either side of it.\n//\n//\tdiagram examples/friday-deploy.dot\n//\tdiagram --out friday-deploy.svg examples/friday-deploy.dot\ndigraph {\n\tlabel = \"Should I deploy on a Friday afternoon?\"\n\tnode [shape = box, style = rounded]\n\n\tstart   [label = \"It's Friday, 16:55\", shape = ellipse]\n\ttesvs   [label = \"Do the tests pass?\"]\n\tfix     [label = \"Fix the tests\\n(or the tests' opinions)\"]\n\twho     [label = \"Is anyone on call\\nwho isn't you?\"]\n\tsmall   [label = \"Is it a one-line change?\"]\n\tsure    [label = \"Are you sure?\"]\n\treally  [label = \"Have you met\\none-line changes?\"]\n\tmonday  [label = \"Deploy on Monday\", style = \"rounded,filled\", fillcolor = \"#8fd18f\"]\n\tdeploy  [label = \"Deploy\", style = \"rounded,filled\", fillcolor = \"#f08a8a\"]\n\tweekend [label = \"Spend the weekend\\nrolling back\", shape = ellipse, style = filled, fillcolor = \"#f5d76e\"]\n\tpub     [label = \"Go home\", shape = ellipse]\n\n\tstart  -> tests\n\ttests  -> fix    [label = \"no\"]\n\tfix    -> tests  [label = \"eventually\", style = dashed]\n\ttests  -> who    [label = \"yes\"]\n\twho    -> monday [label = \"no\"]\n\twho    -> small  [label = \"yes\"]\n\tsmall  -> monday [label = \"no\"]\n\tsmall  -> sure   [label = \"yes\"]\n\tsure   -> really [label = \"yes\"]\n\tsure   -> monday [label = \"no\"]\n\treally -> deploy [label = \"no\", color = \"#c03030\"]\n\treally -> monday [label = \"yes\"]\n\tdeploy -> weekend\n\tmonday -> pub\n}\n")
