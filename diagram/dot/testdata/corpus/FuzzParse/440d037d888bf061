string("// A database replicated across two regions, each database filled with its\n// health, and a legend saying what the colours and lines mean.\n//\n//\tdiagram examples/replication.dot\n//\tdiagram --out replication.png examples/replication.dot\n//\n// columns, rows and style=lane and style=legend are diagram's own; Graphviz\n// ignores them and draws the file as an ordinary graph, so it still draws\n// there, laid out by Graphviz's rules instead. As in Graphviz, a fill\n// needs style=filled.\ndigraph {\n\t// The regions one above the other, each a grid of two columns: a\n\t// database stays in its place whatever its links do, and the columns\n\t// are shared, so dbC is under dbA.\n\trows = 2\n\tnode [shape = cylinder, style = filled]\n\n\tsubgraph cluster_east {\n\t\tlabel = \"us-east-1\"; style = lane; columns = 2\n\t\tdbA [label = \"dbA\\nprimary\", fillcolor = \"#8fd18f\"]   // healthy\n\t\tdbB [label = \"dbB\\nreplica\", fillcolor = \"#f08a8a\"]   // error\n\t}\n\tsubgraph cluster_west {\n\t\tlabel = \"us-west-2\"; style = lane; columns = 2\n\t\tdbC [label = \"dbC\\nreplica\", fillcolor = \"#f5d76e\"]   // warnings\n\t}\n\n\tdyA -> dbB [label = \"sync\"]\n\tdbA -> dbC [label = \"async\", style = dashed]\n\n\t// The legend, drawn below the diagram, outside its grid. A filled node\n\t// is a swatch; a plain one is a line, drawn as an edge is.\n\tsubgraph cluster_legend {\n\t\tlabel = \"Legend\"; style = legend\n\t\thealthy  [label = \"healthy\",                  fillcolor = \"#8fd18f\"]\n\t\twarnings [label = \"working, with warnings\",   fillcolor = \"#f5d76e\"]\n\t\tfailing  [label = \"error\",                    fillcolor = \"#f08a8a\"]\n\t\tsync     [label = \"synchronous replication\",  shape = plain, style = solid]\n\t\tasync    [label = \"asynchronous replication\", shape = plain, style = dashed]\n\t}\n}\n")
